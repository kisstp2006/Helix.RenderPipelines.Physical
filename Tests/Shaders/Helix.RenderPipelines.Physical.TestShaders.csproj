<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Physical pipeline's test shaders: the white furnace over the pipeline's OpenPBR library. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS8981;CS0649;CS0414</NoWarn>
    <RootNamespace>Helix.RenderPipelines.Physical.TestShaders</RootNamespace>
    <AssemblyName>Helix.RenderPipelines.Physical.TestShaders</AssemblyName>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <PropertyGroup>
    <HelixShadersDir Condition="'$(HelixShadersDir)' == ''">$(MSBuildThisFileDirectory)../../External/Helix.Shaders</HelixShadersDir>
    <HelixEngineDir Condition="'$(HelixEngineDir)' == ''">$(MSBuildThisFileDirectory)../../External/Helix.Engine</HelixEngineDir>
    <HelixRenderPipelinesCoreDir Condition="'$(HelixRenderPipelinesCoreDir)' == ''">$(MSBuildThisFileDirectory)../../External/Helix.RenderPipelines.Core</HelixRenderPipelinesCoreDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(HelixShadersDir)/Source/HelixEngine.Shaders/HelixEngine.Shaders.csproj" />
    <ProjectReference Include="$(HelixEngineDir)/Shaders/HelixEngine.BuiltinShaders.csproj" />
    <ProjectReference Include="$(HelixRenderPipelinesCoreDir)/ShaderLibrary/Helix.RenderPipelines.Core.ShaderLibrary.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../Shaders/Helix.RenderPipelines.Physical.Shaders.csproj" />
  </ItemGroup>
</Project>
